{
	"schemaVersion": 1,
	"id": "packbrowser",
	"version": "${version}",
	"name": "Pack Browser",
	"description": "Durchsuche Modrinth-Texturepacks direkt in Minecraft und lade sie mit einem Klick in deinen resourcepacks-Ordner.",
	"authors": [
		"Ubyz"
	],
	"license": "CC0-1.0",
	"icon": "assets/packbrowser/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"de.ubyz.packbrowser.client.PackBrowserClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
